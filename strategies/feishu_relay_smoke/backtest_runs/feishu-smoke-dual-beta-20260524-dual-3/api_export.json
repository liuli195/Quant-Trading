    "data": {
      "source": "JQ_AUTO_AUDIT_TOKEN = 'feishu_relay_smoke-feishu-smoke-dual-beta-20260524212953-5c80b811'\nimport atexit\nimport json\nimport FeishuRelayTools\nSMOKE_MODE = 'beta'\nSMOKE_STRATEGY_NAME = 'FeishuDualB-20260524-dual-3'\nSMOKE_TARGET_VALUE = 16000\nFeishuRelayTools.STRATEGY_NAME = SMOKE_STRATEGY_NAME\nFeishuRelayTools.CURRENT_STRATEGY_NAME = SMOKE_STRATEGY_NAME\nFeishuRelayTools.BUFFER_WAIT_TIME = 1\nFeishuRelayTools.SEND_JITTER_SECONDS = 0\nFeishuRelayTools.RETRY_DELAYS_SECONDS = []\nFeishuRelayTools._outbox = FeishuRelayTools._Outbox(FeishuRelayTools._resolve_outbox_path(FeishuRelayTools.CURRENT_STRATEGY_NAME))\nFeishuRelayTools._sender = FeishuRelayTools._FeishuSender(FeishuRelayTools._outbox)\nFeishuRelayTools._buffer = FeishuRelayTools._OrderBuffer(\n    FeishuRelayTools.BUFFER_WAIT_TIME,\n    FeishuRelayTools.MAX_BUFFER_SIZE,\n    lambda message, replay=False, retry_index=0: FeishuRelayTools._sender.send(message, replay=replay, retry_index=retry_index),\n    FeishuRelayTools.SEND_JITTER_SECONDS,\n)\natexit.register(FeishuRelayTools._buffer.flush)\nSMOKE_OUTBOX_PATH = FeishuRelayTools._resolve_outbox_path(FeishuRelayTools.CURRENT_STRATEGY_NAME)\ndef initialize(context):\n    set_benchmark(\"510300.XSHG\")\n    set_option(\"use_real_price\", True)\n    g.feishu_smoke_ordered = False\n    log.info(\n        \"FEISHU_DUAL_INIT mode=%s strategy=%s outbox=%s wrapped=%s target=%s\"\n        % (\n            SMOKE_MODE,\n            FeishuRelayTools.CURRENT_STRATEGY_NAME,\n            SMOKE_OUTBOX_PATH,\n            getattr(FeishuRelayTools, \"_wrapped_count\", \"NA\"),\n            SMOKE_TARGET_VALUE,\n        )\n    )\n    run_daily(smoke_order, time=\"09:35\", reference_security=\"510300.XSHG\")\n    run_daily(smoke_snapshot, time=\"14:55\", reference_security=\"510300.XSHG\")\ndef smoke_order(context):\n    if g.feishu_smoke_ordered:\n        return\n    g.feishu_smoke_ordered = True\n    order_obj = order_target_value(\"510300.XSHG\", SMOKE_TARGET_VALUE)\n    status = \"OK\" if order_obj is not None else \"NONE\"\n    log.info(\"FEISHU_DUAL_ORDER_RESULT %s mode=%s security=510300.XSHG target=%s\" % (status, SMOKE_MODE, SMOKE_TARGET_VALUE))\ndef _outbox_stats():\n    text = read_file(SMOKE_OUTBOX_PATH) or \"\"\n    pending_events = 0\n    acked_events = 0\n    latest_by_batch = {}\n    for line in text.splitlines():\n        line = line.strip()\n        if not line:\n            continue\n        try:\n            row = json.loads(line)\n        except Exception:\n            continue\n        batch_id = row.get(\"batch_id\")\n        status = row.get(\"status\")\n        if not batch_id or status not in (\"pending\", \"acked\"):\n            continue\n        if status == \"pending\":\n            pending_events += 1\n        elif status == \"acked\":\n            acked_events += 1\n        latest_by_batch.pop(batch_id, None)\n        latest_by_batch[batch_id] = status\n    unacked = sorted(batch_id for batch_id, status in latest_by_batch.items() if status == \"pending\")\n    return pending_events, acked_events, len(unacked), \",\".join(unacked[-3:])\ndef smoke_snapshot(context):\n    try:\n        pending_events, acked_events, unacked_count, sample = _outbox_stats()\n        log.info(\n            \"FEISHU_DUAL_OUTBOX mode=%s events_pending=%s events_acked=%s unacked=%s sample=%s\"\n            % (SMOKE_MODE, pending_events, acked_events, unacked_count, sample)\n        )\n        log.info(\"FEISHU_DUAL_WRAPPED_COUNT %s\" % getattr(FeishuRelayTools, \"_wrapped_count\", \"NA\"))\n    except Exception as exc:\n        log.error(\"FEISHU_DUAL_OUTBOX_READ_ERROR %s\" % exc)"
    },
