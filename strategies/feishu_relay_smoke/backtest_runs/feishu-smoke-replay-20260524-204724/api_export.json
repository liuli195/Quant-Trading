  "source": {
    "data": {
      "source": "JQ_AUTO_AUDIT_TOKEN = 'feishu_relay_smoke-feishu-smoke-replay-20260524211106-3d6df00a'\nimport json\nimport sys\nimport types\ndef _load_feishu_tools():\n    try:\n        import FeishuRelayTools as module\n        return module\n    except Exception:\n        module = types.ModuleType(\"FeishuRelayTools\")\n        sys.modules[\"FeishuRelayTools\"] = module\n        source = read_file(\"FeishuRelayTools.success.py\")\n        if isinstance(source, bytes):\n            source = source.decode(\"utf-8\")\n        exec(source, module.__dict__)\n        return module\nFeishuRelayTools = _load_feishu_tools()\nSMOKE_MODE = 'replay'\nSMOKE_STRATEGY_NAME = '飞书通知冒烟-20260524-204724'\nSMOKE_OUTBOX_PATH = FeishuRelayTools._resolve_outbox_path(FeishuRelayTools.CURRENT_STRATEGY_NAME)\ndef initialize(context):\n    set_benchmark(\"510300.XSHG\")\n    set_option(\"use_real_price\", True)\n    g.feishu_smoke_ordered = False\n    log.info(\n        \"FEISHU_SMOKE_INIT mode=%s strategy=%s outbox=%s wrapped=%s\"\n        % (\n            SMOKE_MODE,\n            FeishuRelayTools.CURRENT_STRATEGY_NAME,\n            SMOKE_OUTBOX_PATH,\n            getattr(FeishuRelayTools, \"_wrapped_count\", \"NA\"),\n        )\n    )\n    run_daily(smoke_order, time=\"09:35\", reference_security=\"510300.XSHG\")\n    run_daily(smoke_snapshot, time=\"14:55\", reference_security=\"510300.XSHG\")\ndef smoke_order(context):\n    log.info(\"FEISHU_SMOKE_REPLAY_NO_ORDER\")\ndef _outbox_stats():\n    text = read_file(SMOKE_OUTBOX_PATH) or \"\"\n    pending_batches = set()\n    acked_batches = set()\n    pending_events = 0\n    acked_events = 0\n    for line in text.splitlines():\n        line = line.strip()\n        if not line:\n            continue\n        try:\n            row = json.loads(line)\n        except Exception:\n            continue\n        batch_id = row.get(\"batch_id\")\n        status = row.get(\"status\")\n        if not batch_id:\n            continue\n        if status == \"pending\":\n            pending_events += 1\n            pending_batches.add(batch_id)\n        elif status == \"acked\":\n            acked_events += 1\n            acked_batches.add(batch_id)\n    unacked = sorted(pending_batches - acked_batches)\n    return pending_events, acked_events, len(unacked), \",\".join(unacked[-3:])\ndef smoke_snapshot(context):\n    try:\n        pending_events, acked_events, unacked_count, sample = _outbox_stats()\n        log.info(\n            \"FEISHU_SMOKE_OUTBOX mode=%s events_pending=%s events_acked=%s unacked=%s sample=%s\"\n            % (SMOKE_MODE, pending_events, acked_events, unacked_count, sample)\n        )\n        log.info(\"FEISHU_SMOKE_WRAPPED_COUNT %s\" % getattr(FeishuRelayTools, \"_wrapped_count\", \"NA\"))\n    except Exception as exc:\n        log.error(\"FEISHU_SMOKE_OUTBOX_READ_ERROR %s\" % exc)"
    },
