{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "PowerShell(Set-Location *)",
      "PowerShell(cd *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\.githooks\\ensure-skill-junction.ps1"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [".venv", "data"]
  }
}
