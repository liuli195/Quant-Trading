#!/bin/sh
set -eu

PRE_PUSH_INPUT="$(cat)"

printf '%s\n' "$PRE_PUSH_INPUT" | sh .githooks/run-python.sh \
  -m scripts.research.governance.branch_protection pre-push
sh .githooks/run-python.sh \
  -m scripts.research.governance.pr_flow pre-push-review-fragments

if [ "${SKIP_GIT_LFS_PRE_PUSH:-}" != "1" ]; then
  command -v git-lfs >/dev/null 2>&1 || {
    printf >&2 "\n%s\n\n" "This repository uses Git LFS but 'git-lfs' was not found on your path."
    exit 2
  }
  printf '%s\n' "$PRE_PUSH_INPUT" | git lfs pre-push "$@"
fi
